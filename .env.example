# 复制为 .env 或在云平台里配置为环境变量。
# 不要把真实 .env 文件提交到 GitHub。

# development：本地开发；production：公网/云端部署
HOME_INVENTORY_ENV=production

# 云端建议把数据目录挂到持久化磁盘，例如 /data。
# 本地不设置时，默认使用项目目录。
HOME_INVENTORY_DATA_DIR=/data

# 首次部署时可用这两个变量自动生成 .security.json。
# 生成后建议删除 HOME_INVENTORY_PASSWORD，只保留持久化磁盘里的 .security.json。
HOME_INVENTORY_USERNAME=family
HOME_INVENTORY_PASSWORD=change-this-password

# 本地 Docker 用 http://localhost:8000 测试时保持 0。
# 公网 HTTPS 部署时改为 1，让登录 Cookie 只通过 HTTPS 发送。
HOME_INVENTORY_HTTPS_ONLY=0

# 生产环境建议限制访问域名。
# 示例：inventory.example.com,www.inventory.example.com
HOME_INVENTORY_ALLOWED_HOSTS=

# 可选配置
HOME_INVENTORY_SESSION_MAX_AGE_SECONDS=43200
HOME_INVENTORY_ENABLE_AUTO_BACKUP=1
HOME_INVENTORY_RECYCLE_BIN_RETENTION_DAYS=30
HOME_INVENTORY_MAX_BACKUP_UPLOAD_MB=100
